NODE_ENV=production
PORT=3000

# PocketID OIDC
POCKETID_ISSUER_URL=https://your-pocketid-instance.com
POCKETID_CLIENT_ID=your-client-id
POCKETID_CLIENT_SECRET=your-client-secret
POCKETID_REDIRECT_URI=https://your-app-domain.com/api/auth/callback

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=8h

# Session
SESSION_SECRET=replace-with-another-long-random-secret

# Frontend URL (used for post-login redirect and CORS)
FRONTEND_URL=https://your-app-domain.com
